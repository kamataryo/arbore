#!/bin/sh
set -eu

# arboré が生成したことを示す目印。remove はこれがあるファイルだけを片付ける
MARK='# generated by arboré'
OVERRIDE=docker-compose.override.yaml

die() { echo "arboré: $*" >&2; exit 1; }

# メインの worktree。worktree の中から呼ばれても本体を基準にする（list の先頭が常に本体）
main_root() {
  m="$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')"
  [ -n "$m" ] || die "git リポジトリの中で実行してください"
  echo "$m"
}

# ブランチ名の / はディレクトリ名に使えないので - にする
slug() { echo "$1" | tr / -; }
wt_dir() { m="$(main_root)"; echo "$(dirname "$m")/$(basename "$m").$(slug "$1")"; }

# Compose のプロジェクト名に使える形（小文字・英数字と _ -）にする
project_name() { basename "$1" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9_-]/-/g'; }

# 使われていない一番小さい番号。ポートのオフセット（× 1000）に使う。
# 番号は各 worktree の gitdir に置くので、git worktree remove で一緒に消える
next_index() {
  common="$(git rev-parse --path-format=absolute --git-common-dir)"
  i=1
  while cat "$common"/worktrees/*/arbore-index 2>/dev/null | grep -qx "$i"; do i=$((i + 1)); done
  echo "$i"
}

# .worktreeinclude のパターンに一致し、かつ gitignore されているファイルを本体からコピーする。
# .worktreeinclude が無ければ、gitignore されたファイルをすべてコピーするか尋ねる（既定は Y）
copy_includes() {
  main="$1" dir="$2"
  if [ -f "$main/.worktreeinclude" ]; then
    pat=--exclude-from=.worktreeinclude label=.worktreeinclude
  else
    printf 'arboré: .worktreeinclude がありません。gitignore されたファイルをすべてコピーしますか？ [Y/n] ' >&2
    read -r ans || ans=
    case "$ans" in [nN]*) return 0 ;; esac
    pat='--exclude=*' label='gitignore 全件'
  fi
  list="$(mktemp)"
  git -C "$main" ls-files --others --ignored --exclude-standard | sort > "$list.ignored"
  git -C "$main" ls-files --others --ignored "$pat" | sort \
    | comm -12 - "$list.ignored" > "$list"
  if [ -s "$list" ]; then
    tar -C "$main" -cf - -T "$list" | tar -C "$dir" -xf -
    echo "コピー   : $(wc -l < "$list" | tr -d ' ') ファイル（${label}）"
  fi
  rm -f "$list" "$list.ignored"
}

# 元の compose を正規化して読み、ぶつかるものだけを書き換えた override を置く。
# - name: 元の compose が name を固定していると、本体と同じプロジェクトとして扱われてしまう
# - container_name: 固定値なので先頭にプロジェクト名を付ける
# - ports: リストは既定だと追記マージで元のポートが残るので、!override で丸ごと置き換える
gen_override() {
  dir="$1" index="$2"
  found=""
  for f in compose.yaml compose.yml docker-compose.yaml docker-compose.yml; do
    [ -e "$dir/$f" ] && found=1
  done
  [ -n "$found" ] || return 0
  for f in compose.override.yml compose.override.yaml docker-compose.override.yml docker-compose.override.yaml; do
    [ -e "$dir/$f" ] && { echo "arboré: $f があるので override の生成をスキップしました" >&2; return 0; }
  done
  command -v docker >/dev/null || { echo "arboré: docker が無いので override の生成をスキップしました" >&2; return 0; }
  command -v jq >/dev/null || die "jq が必要です"

  project="$(project_name "$dir")"
  config="$(cd "$dir" && docker compose config --format json)"
  # name を明示した network / volume はプロジェクト名が付かず、本体と共有されてしまう
  echo "$config" | jq -r --arg p "$(echo "$config" | jq -r .name)" '
    [(.networks, .volumes) | objects | to_entries[]
      | select(.value.external != true and (.value.name // "" | startswith($p + "_") | not)) | .value.name]
    | .[] | "arboré: \(.) は name が固定されているので本体と共有されます"' >&2
  {
    echo "$MARK (index: $index)"
    echo "$config" | jq --arg p "$project" --argjson off "$((index * 1000))" '
      def shift: tostring | split("-") | map(tonumber + $off
        | if . > 65535 then error("ポートが 65535 を超えます: \(.)") else tostring end) | join("-");
      { name: $p,
        services: (.services | map_values(
          (if .container_name then {container_name: "\($p)-\(.container_name)"} else {} end)
          + (if any(.ports[]?; .published) then {ports: [.ports[] | if .published then .published |= shift else . end]} else {} end)
        ) | with_entries(select(.value != {}))) }'
  } | sed 's/^\( *"ports": \)\[/\1!override [/' > "$dir/$OVERRIDE"
  echo "override : $dir/${OVERRIDE}（プロジェクト名 ${project}、ポート +$((index * 1000))）"
}

cmd_create() {
  name="${1:?usage: arboré create <name>}"
  git check-ref-format --branch "$name" >/dev/null 2>&1 || die "ブランチ名に使えません: $name"
  main="$(main_root)"
  dir="$(wt_dir "$name")"
  index="$(next_index)"
  # 既存のブランチ（remove で残したものを含む）はそのまま使う
  if git show-ref --verify --quiet "refs/heads/$name"; then
    git worktree add "$dir" "$name"
  else
    git worktree add -b "$name" "$dir"
  fi
  echo "$index" > "$(git -C "$dir" rev-parse --absolute-git-dir)/arbore-index"
  copy_includes "$main" "$dir"
  gen_override "$dir" "$index"
  echo "worktree : $dir"
  echo "branch   : $name"
}

cmd_remove() {
  name="${1:?usage: arboré remove <name>}"
  dir="$(wt_dir "$name")"
  [ -d "$dir" ] || die "worktree が見つかりません: $dir"
  here="$(pwd -P)" main="$(main_root)"
  # コンテナを消してから git に断られると中途半端に残るので、未コミットの変更は先に見る
  # （安全弁。承知なら git worktree remove --force で直接消す）
  dirty="$(git -C "$dir" status --porcelain | grep -vx "?? $OVERRIDE" || true)"
  [ -z "$dirty" ] || die "未コミットの変更があります: $dir
$dirty"
  if head -n1 "$dir/$OVERRIDE" 2>/dev/null | grep -q "^$MARK"; then
    if command -v docker >/dev/null; then
      (cd "$dir" && docker compose down --remove-orphans --volumes)
    fi
    rm "$dir/$OVERRIDE"
  fi
  git worktree remove "$dir"
  echo "削除しました: $dir"
  echo "ブランチ $name は残しています"
  # 呼び出し元のシェルは消えたディレクトリに残るので、戻り先を案内する（子プロセスからは cd できない）
  case "$here/" in "$dir"/*) echo "arboré: カレントディレクトリが消えました。cd $main で本体に戻れます" >&2 ;; esac
}

# cd "$(arboré dir <name>)" 用。無いときに空を返すと cd がホームへ飛ぶので止める
cmd_dir() {
  dir="$(wt_dir "${1:?usage: arboré dir <name>}")"
  [ -d "$dir" ] || die "worktree が見つかりません: $dir"
  echo "$dir"
}

# arboré で作った worktree の名前（ディレクトリ名の接尾辞）を並べる。補完でも使う
cmd_list() {
  m="$(main_root)"
  prefix="$(dirname "$m")/$(basename "$m")."
  # prefix は正規表現ではなく文字列として比べる（. が / にマッチして repo/.claude/... まで拾わないように）
  git worktree list --porcelain | while IFS= read -r l; do
    case "$l" in "worktree $prefix"*) echo "${l#"worktree $prefix"}" ;; esac
  done
}

cmd_help() {
  cat <<'EOF'
arboré — git worktree の糖衣コマンド

  arboré create <name>   worktree ../<repo>.<name> を作る。ブランチ <name> が無ければ現在の HEAD から作る
                         .worktreeinclude のファイルをコピーし、compose があれば override を置く
  arboré remove <name>   コンテナ・ボリュームごと worktree を消す（ブランチは残す）
  arboré dir <name>      worktree のパスを出力（cd "$(arboré dir <name>)"）
  arboré list            arboré で作った worktree の名前を一覧
  arboré help            このヘルプ
  arboré completion      補完スクリプトを出力（eval "$(arboré completion)"）
EOF
}

cmd_completion() {
  cat <<'EOF'
if [ -n "${ZSH_VERSION:-}" ]; then
  _arbore() {
    if (( CURRENT == 2 )); then
      compadd create remove dir list help completion
    elif (( CURRENT == 3 )) && [[ $words[2] == remove || $words[2] == dir ]]; then
      compadd -- ${(f)"$(arboré list 2>/dev/null)"}
    fi
  }
  compdef _arbore arboré
else
  _arbore() {
    case "$COMP_CWORD" in
      1) COMPREPLY=($(compgen -W "create remove dir list help completion" -- "${COMP_WORDS[1]}")) ;;
      2) case "${COMP_WORDS[1]}" in remove|dir) COMPREPLY=($(compgen -W "$(arboré list 2>/dev/null)" -- "${COMP_WORDS[2]}")) ;; esac ;;
    esac
    return 0
  }
  complete -F _arbore arboré
fi
EOF
}

case "${1:-}" in
  create)      shift; cmd_create "$@" ;;
  remove)      shift; cmd_remove "$@" ;;
  dir)         shift; cmd_dir "$@" ;;
  list)        cmd_list ;;
  completion)  cmd_completion ;;
  help|'')     cmd_help ;;
  *)           cmd_help >&2; exit 1 ;;
esac
